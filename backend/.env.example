APP_ENV=production
EXTERNAL_SERVICES_ENABLED=false
# Required application settings
# Railway injects PORT automatically; use 8000 only for manual local runs.
PORT=8000
MONGO_URL=mongodb://localhost:27017
DB_NAME=beside
JWT_SECRET_KEY=
# External secret used to encrypt TOTP secrets at rest; never store in MongoDB.
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000
FRONTEND_PUBLIC_URL=https://app.mybeside.pro
PUBLIC_APP_URL=https://app.mybeside.pro
# Owner portal origin; keep it separate from the customer application origin.
ADMIN_PUBLIC_URL=https://admin.mybeside.pro
COOKIE_SECURE=true
COOKIE_SAMESITE=none
RATE_LIMITING_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=false
# Optional post-verification profile wizard. Keep disabled until the onboarding copy/privacy review is complete.
ONBOARDING_FEATURE_ENABLED=false
TERMS_VERSION=draft-2026-11
PRIVACY_NOTICE_VERSION=draft-2026-11
CONSENT_VERSION=v1

# Transactional email via Resend. Set EMAIL_VERIFICATION_REQUIRED=true only
# after RESEND_API_KEY is configured in the deployment environment and the
# sender domain is verified in Resend.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=Beside <notify@mybeside.pro>
RESEND_API_URL=https://api.resend.com/emails
# Legacy SendGrid settings are retained only for older environments.
SENDGRID_API_KEY=
SENDER_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Photo AI remains disabled until a provider, retention policy and pricing are approved.
PHOTO_AI_ENABLED=false
PHOTO_AI_LIVE_ENABLED=false
PHOTO_AI_PROVIDER=openai
PHOTO_AI_API_URL=https://api.openai.com/v1/images/edits
PHOTO_AI_API_KEY=
PHOTO_AI_MODEL=gpt-image-2.5-sunburst
PHOTO_AI_QUALITY=medium
PHOTO_AI_TIMEOUT_SECONDS=120
PHOTO_AI_DAILY_LIMIT=10
OAUTH_SESSION_URL=

# Optional live integration tests
BACKEND_TEST_URL=
BESIDE_TEST_USER_EMAIL=
BESIDE_TEST_USER_PASSWORD=
BESIDE_TEST_ADMIN_EMAIL=
BESIDE_TEST_ADMIN_PASSWORD=

# Optional Stripe Billing (real requests require EXTERNAL_SERVICES_ENABLED=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ELITE=
# Local demo only; messages saved here instead of being sent.
LOCAL_OUTBOX_DIR=
