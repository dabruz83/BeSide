# Required application settings
# Railway injects PORT automatically; use 8000 only for manual local runs.
PORT=8000
MONGO_URL=mongodb://localhost:27017
DB_NAME=beside
JWT_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMITING_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=false

# Transactional email. Set EMAIL_VERIFICATION_REQUIRED=true only after both
# SENDGRID_API_KEY and a verified SENDER_EMAIL are configured.
SENDGRID_API_KEY=
SENDER_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
EMERGENT_LLM_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
OAUTH_SESSION_URL=

# Optional live integration tests
BACKEND_TEST_URL=
BESIDE_TEST_USER_EMAIL=
BESIDE_TEST_USER_PASSWORD=
BESIDE_TEST_ADMIN_EMAIL=
BESIDE_TEST_ADMIN_PASSWORD=
